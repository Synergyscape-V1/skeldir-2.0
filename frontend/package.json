{
  "name": "frontend-3.0",
  "version": "1.0.0",
  "description": "Skeldir frontend workspace",
  "main": "index.js",
  "scripts": {
    "dev": "vite --port 5173",
    "app:dev": "vite --port 5173",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "contract:compile": "tsc -p tsconfig.contract-gate.json --noEmit",
    "contract:compile:negative": "node scripts/contractNegativeControl.mjs",
    "certify:data-health": "npx tsc --noEmit && node scripts/check-data-health-colors.mjs && node scripts/check-data-health-stories.mjs",
    "certify:channel-comparison": "npx tsc --noEmit && node scripts/check-channel-comparison-tokens.mjs && node scripts/check-channel-comparison-stories.mjs && node scripts/check-channel-comparison-validation.mjs",
    "storybook:eval": "storybook dev -p 6007 --config-dir .storybook-eval"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "storybook": "^8.6.14",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
