{
  "contract_id": "b15.p5.frontend_control_grammar.main",
  "contract_version": "1.2.0",
  "phase": "B1.5-P5",
  "required_lifecycle_statuses": [
    "submitted",
    "validating",
    "investigating",
    "ready_for_review",
    "approved",
    "rejected",
    "refine_requested",
    "rerun_requested",
    "completed",
    "failed",
    "timeout",
    "cancelled"
  ],
  "result_ready_statuses": [
    "ready_for_review",
    "approved",
    "rejected",
    "completed"
  ],
  "bounded_surfaces": [
    "frontend/src/budget/components/BudgetOptimizer.tsx",
    "frontend/src/investigations/InvestigationConsole.tsx",
    "frontend/src/components/llm/InvestigationStatePanel.tsx",
    "frontend/src/components/llm/controlPlane.ts",
    "frontend/src/components/llm/useBudgetCentaurController.ts",
    "frontend/src/components/llm/useInvestigationCentaurController.ts"
  ],
  "required_poll_interval_ms": 5000,
  "required_idempotency_header_marker": "idempotencyKey: idempotencyKey",
  "required_attempt_scoped_idempotency_markers": [
    "createMutationAttemptFingerprint(",
    "resolveAttemptIdempotencyKey(",
    "clearMutationAttemptState(",
    "mutationAttemptRef"
  ],
  "required_problem_response_mapping_markers": [
    "error instanceof ApiContractError",
    "INVALID_STATE_TRANSITION",
    "IDEMPOTENCY_KEY_CONFLICT",
    "status === 400 || status === 422"
  ],
  "required_branch_specific_reconciliation_markers": [
    "if (issue.kind === \"invalid_state_transition\")",
    "if (issue.kind === \"not_found\")",
    "if (issue.kind === \"result_not_ready\")",
    "reconcileAuthoritativeSnapshot(",
    "teardownForMissingResource(",
    "setIsSnapshotAuthoritative(false);",
    "snapshot.isAuthoritative === false",
    "data-authoritative-reconciliation=\"true\""
  ],
  "forbidden_local_simulation_markers": [
    "mockApi",
    "mockInvestigations",
    "startBudgetOptimizationJob",
    "setTimeout("
  ],
  "forbidden_authority_from_synthesis_markers": [
    "non_authoritative_summary.match",
    "non_authoritative_summary.replace",
    "non_authoritative_summary.split",
    "summaryText"
  ],
  "proof_surfaces": [
    "scripts/ci/enforce_b15_p5_frontend_control_grammar.py",
    "backend/tests/test_b15_p5_frontend_control_grammar_enforcer.py"
  ]
}
