{
  "contract_id": "b15.p7.ci_adjudication_closure.main",
  "contract_version": "1.2.1",
  "phase": "B1.5-P7",
  "required_ci_job": {
    "job_id": "b15-p7-ci-adjudication-closure",
    "job_name": "B1.5 P7 Technical Closure Harness, Browser E2E Truth, and Mental-Model Blocking Gate",
    "needs": [
      "checkout",
      "validate-contracts",
      "b15-p6-anti-cyborg-governance-lock"
    ],
    "required_commands": [
      "python scripts/ci/enforce_b15_p7_ci_adjudication_closure.py",
      "pytest backend/tests/test_b15_p7_ci_adjudication_closure_enforcer.py -q",
      "pytest backend/tests/test_b15_p7_ci_adjudication_closure.py -q",
      "python scripts/ci/prepare_b15_p7_browser_runtime.py",
      "npx playwright test tests/b15-p7-browser-e2e.spec.ts --project=chromium --workers=1 --reporter=line,json",
      "python scripts/ci/assert_b15_p7_playwright_execution.py"
    ]
  },
  "required_runtime_test_markers": [
    "test_b15_p7_canonical_launch_poll_review_terminalization_journey",
    "test_b15_p7_poll_cadence_controlled_time_stays_within_three_to_seven_seconds",
    "test_b15_p7_failure_timeout_cancel_and_retry_are_distinct_and_recoverable",
    "test_b15_p7_network_layer_duplicate_review_actions_are_single_effect",
    "test_b15_p7_runtime_anti_theater_no_streaming_and_no_hidden_auto_accept"
  ],
  "required_browser_test": {
    "file": "tests/b15-p7-browser-e2e.spec.ts",
    "required_markers": [
      "test_b15_p7_browser_launch_poll_review_terminalized_state",
      "test_b15_p7_browser_conflict_response_surfaces_ui_issue_and_reconciliation"
    ],
    "forbidden_markers": [
      "route.fulfill(",
      "test.skip(",
      "Set B15_P7_E2E_BEARER_TOKEN to run browser-level B1.5-P7 closure proofs."
    ]
  },
  "required_deploy_gate": {
    "workflow_file": ".github/workflows/schema-deploy-production.yml",
    "required_commands": [
      "python scripts/ci/b15_p7_phase_closure_gate.py",
      "--mode technical",
      "--status-file docs/forensics/evidence/b15_p7/mental_model_study/status.json"
    ]
  },
  "mental_model_study": {
    "required_files": [
      "docs/forensics/evidence/b15_p7/mental_model_study/README.md",
      "docs/forensics/evidence/b15_p7/mental_model_study/protocol.md",
      "docs/forensics/evidence/b15_p7/mental_model_study/facilitator_script.md",
      "docs/forensics/evidence/b15_p7/mental_model_study/scoring_rubric.md",
      "docs/forensics/evidence/b15_p7/mental_model_study/execution_checklist.md",
      "docs/forensics/evidence/b15_p7/mental_model_study/participant_results_template.csv",
      "docs/forensics/evidence/b15_p7/mental_model_study/status.json"
    ],
    "status_file": "docs/forensics/evidence/b15_p7/mental_model_study/status.json",
    "allowed_statuses": [
      "pending_human_execution",
      "validated_by_humans"
    ],
    "pending_requires_zero_participants": true,
    "pending_must_not_claim_success": true,
    "pending_requires_phase_closure_state": "open_pending_human_execution",
    "pending_requires_full_phase_claim_false": true,
    "validated_requires_eight_of_ten": true,
    "required_human_execution_markers": [
      "Human Execution Required",
      "No fabricated participant outcomes"
    ]
  },
  "closure_integrity": {
    "evidence_file": "docs/forensics/B1.5-P7 Remediation Evidence Pack .md",
    "pending_requires_evidence_markers": [
      "Phase Closure Status: OPEN (pending_human_execution)",
