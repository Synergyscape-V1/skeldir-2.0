    "alias_route": "/api/webhooks/stripe/payment_intent/succeeded",
    "required_equivalence_classes": [
      "success",
      "forged_signature",
      "malformed_authenticated_payload",
      "missing_tenant_key",
      "wrong_tenant_key",
      "unsupported_event_family",
      "performance_p95"
    ]
  },
  "required_runtime_proofs": [
    "backend/tests/test_b22_p5_performance_negative_controls.py::test_b22_p5_negative_control_matrix_includes_route_owned_provider_safe_unsupported_family_semantics",
    "backend/tests/test_b22_p5_performance_negative_controls.py::test_b22_p5_stripe_alias_and_canonical_routes_have_equivalent_success_failure_and_unsupported_family_semantics"
  ],
  "required_ci_wiring": [
    "python scripts/ci/enforce_b22_p5_performance_negative_control_lock.py",
