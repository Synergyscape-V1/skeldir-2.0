      "forged_signature",
      "missing_tenant_key",
      "wrong_tenant_key",
      "malformed_payload",
      "oversized_payload",
      "duplicate_replay",
      "unsupported_event_family"
    ],
    "unsupported_event_family_contract": {
      "response_status": "unsupported_event_family_ignored",
