{
  "matrix_schema_version": "b25-p13-c14-trust-semantic-authority-v1",
  "governing_invariant": "Every signed semantic is an exact projection of the authoritative P5 snapshot plus the single controlled P7 audit transform before P8 private-key use.",
  "universal_boundary": {
    "who_may_mutate": "P5 owns source projection; P7 may replace only audit_ref, audit_hash, audit provenance entries, semantic_truth_hash, and signature_hash; P8 may replace only signing metadata, derived hashes, and signature.",
    "correspondence_proof": "P5 canonical bytes are sealed in TrustEnvelopeBuildWitness; P7 reconstructs its allowed transform and requires byte equality; AuthorizedTrustEnvelope is immutable and content-addressed.",
    "immutable_at": "AuthorizedTrustEnvelope capability mint after durable P7 audit composition.",
    "validated_before_issuance": "_authorize_audited_trust_envelope then AuthorizedTrustEnvelope._validated_payload_copy before active private-key selection.",
    "failure_behavior": "TrustSemanticAuthorityError or TrustEnvelopeSigningError; Ed25519 sign call count remains zero.",
    "public_verification_limit": "Public JWKS proves byte integrity, key identity, and temporal validity; producing-authority truth is therefore enforced before signature issuance, not inferred by the public verifier."
  },
  "fields": [
    {"field":"envelope_version","external_meaning":"wire envelope protocol","authoritative_source":"trust-envelope contract","producer":"P5 contract adapter","claim_group":"protocol"},
    {"field":"schema_version","external_meaning":"schema semantics","authoritative_source":"schema-version registry","producer":"P5 request compatibility gate","claim_group":"protocol"},
    {"field":"canonicalization_version","external_meaning":"canonical byte semantics","authoritative_source":"canonicalization-version registry","producer":"P5 request compatibility gate","claim_group":"protocol"},
    {"field":"semantic_unicode_probe","external_meaning":"fixture-only UTF-8 semantic probe","authoritative_source":"trust-envelope schema const","producer":"contract fixtures only; no production source decision","claim_group":"protocol"},
    {"field":"envelope_id","external_meaning":"stable request-subject envelope identifier","authoritative_source":"tenant hash, subject ref, protocol versions","producer":"P5 deterministic identity builder","claim_group":"identity"},
    {"field":"tenant_id_hash","external_meaning":"opaque tenant ownership","authoritative_source":"authenticated request tenant UUID","producer":"P5 tenant_hash","claim_group":"identity"},
    {"field":"audience_binding","external_meaning":"presenter and scope boundary","authoritative_source":"authenticated machine caller context","producer":"P5 audience adapter","claim_group":"identity"},
    {"field":"subject_authority","external_meaning":"subject ownership and allowed evidence tables","authoritative_source":"subject-authority registry plus exact source row","producer":"P5 subject adapter","claim_group":"identity"},
    {"field":"subject_type","external_meaning":"kind of fact asserted","authoritative_source":"bounded request matched to source type","producer":"P5 subject adapter","claim_group":"identity"},
    {"field":"subject_ref","external_meaning":"exact authoritative subject","authoritative_source":"tenant-scoped source row identifier","producer":"P5 subject adapter","claim_group":"identity"},
    {"field":"subject_ref_hash","external_meaning":"opaque subject commitment","authoritative_source":"exact subject_ref","producer":"P5 tagged SHA-256","claim_group":"identity"},
    {"field":"truth_type","external_meaning":"epistemic class of claim","authoritative_source":"subject authority and confidence state machine","producer":"P5 subject adapter","claim_group":"truth"},
    {"field":"truth_authority","external_meaning":"source system and snapshot owning truth","authoritative_source":"persisted B2.3/B2.4 observation","producer":"P5 source adapter","claim_group":"source_window"},
    {"field":"deterministic_verification_status","external_meaning":"revenue verification result","authoritative_source":"B2.3 deterministic revenue authority","producer":"future supported subject adapter; currently non-issuable","claim_group":"financial"},
    {"field":"match_verdict_status","external_meaning":"normalized deterministic match result","authoritative_source":"b23_match_verdicts.status","producer":"P5 match adapter","claim_group":"financial"},
    {"field":"verified_revenue_minor","external_meaning":"verified money in integer minor units","authoritative_source":"P4-approved deterministic money mapping","producer":"supported financial subject adapter; match-verdict wire shape forbids it","claim_group":"financial"},
    {"field":"currency","external_meaning":"ISO-4217 unit of financial amount","authoritative_source":"same P4 money decision as amount","producer":"supported financial subject adapter; match-verdict wire shape forbids it","claim_group":"financial"},
    {"field":"discrepancy_class","external_meaning":"reconciliation classification","authoritative_source":"reconciliation deterministic authority","producer":"future supported subject adapter; currently non-issuable","claim_group":"financial"},
    {"field":"attribution_model","external_meaning":"deterministic allocation method","authoritative_source":"persisted attribution authority","producer":"future supported subject adapter; currently non-issuable","claim_group":"model"},
    {"field":"model_assumption","external_meaning":"causal/non-causal interpretation","authoritative_source":"attribution model registry","producer":"future supported subject adapter; currently non-issuable","claim_group":"model"},
    {"field":"causal_status","external_meaning":"causal claim boundary","authoritative_source":"attribution model registry","producer":"future supported subject adapter; currently non-issuable","claim_group":"model"},
    {"field":"confidence_metadata","external_meaning":"confidence state, model, diagnostics, reason, and producing policy","authoritative_source":"persisted B2.4 fit/classification or deterministic-only state","producer":"P5 canonical confidence state machine","claim_group":"confidence_policy"},
    {"field":"provenance_chain","external_meaning":"ordered evidence and decision lineage","authoritative_source":"exact B2.3/B2.4 source snapshot plus P7 audit record","producer":"P5 provenance adapter plus controlled P7 replacement","claim_group":"source_window"},
    {"field":"data_completeness_status","external_meaning":"evidence sufficiency","authoritative_source":"source lifecycle and confidence decision","producer":"P5 source adapter","claim_group":"confidence_policy"},
    {"field":"benchmark_metadata","external_meaning":"benchmark availability and identity","authoritative_source":"benchmark registry or explicit unavailable authority","producer":"P5 benchmark adapter","claim_group":"benchmark"},
    {"field":"policy_action_authority","external_meaning":"non-executable read-only action boundary","authoritative_source":"Trust policy defaults","producer":"P5 policy adapter","claim_group":"policy"},
    {"field":"fallback_applied","external_meaning":"whether degraded semantics were used","authoritative_source":"canonical confidence/source state machine","producer":"P5 state adapter","claim_group":"confidence_policy"},
    {"field":"fallback_reason","external_meaning":"why truth is degraded or unavailable","authoritative_source":"canonical confidence/source state machine","producer":"P5 state adapter","claim_group":"confidence_policy"},
    {"field":"evidence_temporal_boundary","external_meaning":"snapshot, read window, freshness, and consistency","authoritative_source":"persisted source observation timestamps","producer":"P5 temporal adapter","claim_group":"source_window"},
    {"field":"audit_ref","external_meaning":"durable issuance audit identity","authoritative_source":"tenant-scoped P7 audit persistence","producer":"P7 controlled transform","claim_group":"audit"},
    {"field":"audit_hash","external_meaning":"canonical audit material commitment","authoritative_source":"P7 audit hash domain","producer":"P7 controlled transform","claim_group":"audit"},
    {"field":"semantic_truth_hash","external_meaning":"content identity of load-bearing semantics","authoritative_source":"P2 semantic hash-domain manifest","producer":"P5 then recomputed by P7/P8 after controlled transforms","claim_group":"cryptographic"},
    {"field":"artifact_ref","external_meaning":"exact Bayesian artifact identity","authoritative_source":"persisted B2.4 artifact record or explicit null","producer":"P5 confidence adapter","claim_group":"artifact"},
    {"field":"artifact_hash","external_meaning":"Bayesian artifact byte commitment","authoritative_source":"persisted B2.4 artifact hash or explicit null","producer":"P5 confidence adapter","claim_group":"artifact"},
    {"field":"signature_hash","external_meaning":"content-addressed signature material identity","authoritative_source":"P2 signature hash domain","producer":"P8 signer","claim_group":"cryptographic"},
    {"field":"signature","external_meaning":"Skeldir issuance authority","authoritative_source":"active TrustEnvelope Ed25519 private key","producer":"P8 capability-only signer","claim_group":"cryptographic"},
    {"field":"signing_algorithm","external_meaning":"signature algorithm","authoritative_source":"active key registry plus schema","producer":"P8 signer","claim_group":"cryptographic"},
    {"field":"signing_key_id","external_meaning":"active/historical verification key identity","authoritative_source":"Trust key registry","producer":"P8 signer","claim_group":"cryptographic"},
    {"field":"created_at","external_meaning":"issuance time","authoritative_source":"request issuance context with declared timestamp source","producer":"P5 request adapter","claim_group":"temporal"},
    {"field":"valid_until","external_meaning":"claim validity horizon","authoritative_source":"bounded request/default temporal policy","producer":"P5 temporal adapter","claim_group":"temporal"},
    {"field":"untrusted_display_data","external_meaning":"non-authoritative quarantined provider text","authoritative_source":"P3 text-disposition result","producer":"P5 display adapter","claim_group":"display_only"}
  ],
  "compound_claims": [
    {"claim":"tenant_subject_authority","fields":["tenant_id_hash","subject_authority","subject_type","subject_ref","subject_ref_hash"],"correspondence":"all values equal the exact authenticated request and tenant-scoped source identity"},
    {"claim":"deterministic_financial_authority","fields":["match_verdict_status","verified_revenue_minor","currency","provenance_chain","truth_authority"],"correspondence":"the exact P4 money decision and B2.3 snapshot are sealed before audit enrichment"},
    {"claim":"source_temporal_authority","fields":["truth_authority","provenance_chain","evidence_temporal_boundary","created_at","valid_until"],"correspondence":"snapshot identity and historical observation window remain those P5 observed; P8 performs no source reread"},
    {"claim":"confidence_state_machine","fields":["truth_type","confidence_metadata","data_completeness_status","fallback_applied","fallback_reason","artifact_ref","artifact_hash"],"correspondence":"status cannot weaken model, diagnostic, artifact, reason, or producing-policy obligations"},
    {"claim":"audit_and_crypto_domains","fields":["audit_ref","audit_hash","semantic_truth_hash","signature_hash","signature","signing_algorithm","signing_key_id"],"correspondence":"P7 and P8 use distinct canonical hash/signature domains and only their declared transforms"}
  ]
}
