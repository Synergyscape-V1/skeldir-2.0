{
  "contract_id": "b23.pre_p1.spec_gate.main",
  "contract_version": "1.0.0",
  "repository": "Synergyscape-V1/skeldir-2.0",
  "branch": "main",
  "phase": "B2.3-Pre-P1",
  "description": "Machine-adjudicated Pre-P1 semantic authority closure for B2.3 P1 readiness.",
  "inherits_from": {
    "b23_p0_semantic_authority_freeze_contract": "contracts-internal/governance/b23_p0_semantic_authority_freeze.main.json",
    "required_invariants": [
      "b23_p0_semantic_authority_freeze",
      "b06_false_authority_exclusion",
      "typed_boundary_source_alignment",
      "no_llm_deterministic_authority_path",
      "tenant_isolation",
      "activity_independent_db_native_lifecycle"
    ]
  },
  "p0_inherited_truth_correction": {
    "activity_independent_lifecycle_mode": "database_scheduled_pruning",
    "governed_runtime_mechanism": "governed_neon_pg_cron",
    "scheduled_job_name": "b23_p0_prune_attribution_commerce_identities_hourly",
    "forbid_trigger_only_authority_claim": true,
    "preserve_contract_version": "1.4.0",
    "preserve_false_authority_exclusion": true,
    "preserve_no_llm_deterministic_authority_path": true
  },
  "revenue_extraction_standard": {
    "canonical_amount_basis": "verified_captured_gross_amount_excluding_processor_fees",
    "canonical_storage": {
      "amount": "integer_minor_units",
      "currency": "iso_4217_code",
      "binary_float_forbidden": true,
      "binary_float_forbidden_scopes": [
        "canonical_financial_storage",
        "match_arithmetic",
        "discrepancy_percentage_computation",
        "refund_chargeback_adjustment_arithmetic",
        "test_fixtures_except_explicit_rejection_or_normalization_tests"
      ],
      "numeric_exception_policy": {
        "postgres_numeric_allowed_only_with_declared_scale": true,
        "declared_rounding_mode_required": true,
        "default_rounding_mode": "ROUND_HALF_UP"
      }
    },
    "platform_keyed_extraction_registry_requirement": {
      "required": true,
      "inline_provider_amount_access_in_match_kernel_forbidden": true,
      "registry_key": "provider",
      "missing_registry_entry_must_fail_tests": true
    },
    "providers": {
      "stripe": {
        "authoritative_revenue_field": "data.object.amount",
        "source_currency_field": "data.object.currency",
        "source_amount_unit": "minor_units_integer",
        "canonical_amount_basis": "captured_payment_intent_gross",
        "canonical_amount_field": "verified_amount_minor",
        "canonical_storage_unit": "minor_units_integer",
        "currency_exponent_source": "iso_4217_exponent_by_currency",
        "rounding_mode": "ROUND_HALF_UP",
        "tax_inclusion": "unknown",
        "shipping_inclusion": "unknown",
        "discount_inclusion": "unknown",
        "processor_fee_inclusion": "no",
        "refund_chargeback_adjustment_posture": "append_only_adjustment_events",
        "multi_currency_posture": "same_currency_only_no_cross_currency_match"
      },
      "paypal": {
        "authoritative_revenue_field": "amount.total",
        "source_currency_field": "amount.currency",
        "source_amount_unit": "decimal_string_major_units",
        "canonical_amount_basis": "captured_sale_or_capture_gross",
        "canonical_amount_field": "verified_amount_minor",
        "canonical_storage_unit": "minor_units_integer",
        "currency_exponent_source": "iso_4217_exponent_by_currency",
        "rounding_mode": "ROUND_HALF_UP",
        "tax_inclusion": "unknown",
        "shipping_inclusion": "unknown",
        "discount_inclusion": "unknown",
        "processor_fee_inclusion": "no",
        "refund_chargeback_adjustment_posture": "append_only_adjustment_events",
        "multi_currency_posture": "same_currency_only_no_cross_currency_match"
      },
      "shopify": {
        "authoritative_revenue_field": "total_price",
        "source_currency_field": "currency",
        "source_amount_unit": "decimal_string_major_units",
        "canonical_amount_basis": "order_total_gross",
        "canonical_amount_field": "verified_amount_minor",
        "canonical_storage_unit": "minor_units_integer",
        "currency_exponent_source": "iso_4217_exponent_by_currency",
        "rounding_mode": "ROUND_HALF_UP",
        "tax_inclusion": "yes",
        "shipping_inclusion": "yes",
        "discount_inclusion": "yes",
        "processor_fee_inclusion": "no",
        "refund_chargeback_adjustment_posture": "append_only_adjustment_events",
        "multi_currency_posture": "same_currency_only_no_cross_currency_match"
      },
      "woocommerce": {
        "authoritative_revenue_field": "total",
        "source_currency_field": "currency",
        "source_amount_unit": "decimal_string_major_units",
        "canonical_amount_basis": "order_total_gross",
        "canonical_amount_field": "verified_amount_minor",
        "canonical_storage_unit": "minor_units_integer",
        "currency_exponent_source": "iso_4217_exponent_by_currency",
        "rounding_mode": "ROUND_HALF_UP",
        "tax_inclusion": "yes",
        "shipping_inclusion": "yes",
        "discount_inclusion": "yes",
        "processor_fee_inclusion": "no",
        "refund_chargeback_adjustment_posture": "append_only_adjustment_events",
        "multi_currency_posture": "same_currency_only_no_cross_currency_match"
      }
    },
    "unsupported_or_ambiguous_field_policy": "fail_closed_to_unmatched_or_unsupported_with_audit_reason",
    "rationale": "Canonical matching must compare gross captured commerce amounts normalized into integer minor units with explicit currency semantics, excluding processor fees and avoiding binary floating-point ambiguity."
  },
  "refund_chargeback_concurrency_law": {
    "model": "append_only_immutable_revenue_events",
    "tenant_scoped_provider_idempotency_required": true,
    "database_duplicate_event_rejection_required": true,
    "forbid_unsafe_read_modify_write_net_updates": true,
    "net_revenue_computation": "capture_plus_committed_adjustment_event_aggregation_or_materialized_under_explicit_locking_or_versioning",
    "required_concurrency_controls": [
      "row_level_lock",
      "serializable_transaction",
      "optimistic_version_check",
      "equivalent_deterministic_control"
    ],
    "concurrent_partial_refunds_requirement": "two_distinct_concurrent_partial_refunds_for_same_order_must_persist_exactly_once_each",
    "distinct_adjustment_events": [
      "refund_partial",
      "refund_full",
      "chargeback_opened",
      "chargeback_won",
      "chargeback_lost",
      "reversal"
    ]
  },
  "table_privacy_lifecycle_pre_spec": {
    "global_rules": {
      "tenant_isolation_required": true,
      "rls_required": true,
      "pii_forbidden": true,
      "raw_provider_payload_must_be_minimized": true
    },
    "table_classes": {
      "match_verdicts": {
        "data_classification": "financial_verification_decision_data",
        "allowed_identifier_classes": ["tenant_id", "provider", "commerce_reference", "transaction_reference"],
        "forbidden_columns": ["email", "full_name", "phone", "full_ip", "street_address", "device_id", "cross_device_identifier"],
        "raw_provider_payload_posture": "forbidden",
        "tenant_isolation_requirement": "tenant_id_uuid_fk",
        "rls_requirement": "tenant_id_equals_current_setting_app_current_tenant_id",
        "retention_or_archival_class": "financial_audit_long_retention",
        "lifecycle_mechanism": "governed_archival_policy",
        "retention_rationale": "match verdicts are audit evidence and may exceed identity TTL"
      },
      "exception_records": {
        "data_classification": "financial_discrepancy_workflow_data",
        "allowed_identifier_classes": ["tenant_id", "provider", "commerce_reference", "exception_reference"],
        "forbidden_columns": ["email", "full_name", "phone", "full_ip", "street_address", "device_id", "cross_device_identifier"],
        "raw_provider_payload_posture": "forbidden",
        "tenant_isolation_requirement": "tenant_id_uuid_fk",
        "rls_requirement": "tenant_id_equals_current_setting_app_current_tenant_id",
        "retention_or_archival_class": "financial_audit_long_retention",
        "lifecycle_mechanism": "governed_archival_policy",
        "retention_rationale": "exceptions require durable investigation evidence"
      },
      "revenue_events": {
        "data_classification": "financial_event_ledger_data",
        "allowed_identifier_classes": ["tenant_id", "provider", "provider_event_reference", "commerce_reference"],
        "forbidden_columns": ["email", "full_name", "phone", "full_ip", "street_address", "device_id", "cross_device_identifier"],
        "raw_provider_payload_posture": "hashed_or_redacted_minimum_fields_only",
        "tenant_isolation_requirement": "tenant_id_uuid_fk",
        "rls_requirement": "tenant_id_equals_current_setting_app_current_tenant_id",
        "retention_or_archival_class": "financial_audit_long_retention",
        "lifecycle_mechanism": "append_only_with_governed_archival",
        "retention_rationale": "ledger-grade adjustment evidence requires long retention"
      },
      "webhook_ingestion_logs": {
        "data_classification": "operational_integrity_event_log",
        "allowed_identifier_classes": ["tenant_id", "provider", "event_reference", "correlation_id"],
        "forbidden_columns": ["email", "full_name", "phone", "full_ip", "street_address", "device_id", "cross_device_identifier"],
        "raw_provider_payload_posture": "redacted_or_structurally_minimized",
        "tenant_isolation_requirement": "tenant_id_uuid_fk",
        "rls_requirement": "tenant_id_equals_current_setting_app_current_tenant_id",
        "retention_or_archival_class": "operational_short_to_medium_retention",
        "lifecycle_mechanism": "database_native_retention_or_governed_archival",
        "retention_rationale": "operational debugging evidence with bounded storage"
      },
      "read_models_or_materialized_summaries": {
        "data_classification": "derived_financial_summary_data",
        "allowed_identifier_classes": ["tenant_id", "provider", "period_key"],
        "forbidden_columns": ["email", "full_name", "phone", "full_ip", "street_address", "device_id", "cross_device_identifier"],
        "raw_provider_payload_posture": "forbidden",
        "tenant_isolation_requirement": "tenant_id_uuid_fk",
        "rls_requirement": "tenant_id_equals_current_setting_app_current_tenant_id",
        "retention_or_archival_class": "derived_summary_rebuildable",
        "lifecycle_mechanism": "materialized_view_refresh_and_rebuild",
        "retention_rationale": "read models are rebuildable from authoritative event tables"
      }
    }
  },
  "timing_constants": {
    "WEBHOOK_ARRIVAL_WINDOW": {
      "value": 30,
      "unit": "minutes",
      "rationale": "Bounds expected post-capture webhook propagation delay before unmatched classification is allowed.",
      "consuming_phases": ["P1", "P2", "P3", "P4"],
      "tenant_configurable_pre_launch": false,
      "state_transition_effect": "pending_to_unmatched_blocked_until_window_elapsed",
      "future_constants_module_name": "WEBHOOK_ARRIVAL_WINDOW"
    },
    "PROVISIONAL_MATCH_WINDOW": {
      "value": 24,
      "unit": "hours",
      "rationale": "Allows asynchronous refund/chargeback signals before terminal confirmation.",
      "consuming_phases": ["P1", "P2", "P3", "P4"],
      "tenant_configurable_pre_launch": false,
      "state_transition_effect": "provisional_to_confirmed_after_window_without_adjustments",
      "future_constants_module_name": "PROVISIONAL_MATCH_WINDOW"
    },
    "REFUND_REOPENING_WINDOW": {
      "value": 30,
      "unit": "days",
      "rationale": "Supports realistic post-confirmation refund and early chargeback correction windows.",
      "consuming_phases": ["P1", "P2", "P3", "P4"],
      "tenant_configurable_pre_launch": false,
      "state_transition_effect": "confirmed_can_reopen_on_adjustment_events_within_window",
      "future_constants_module_name": "REFUND_REOPENING_WINDOW"
    },
    "performance_scope": {
      "lt_10_seconds_definition": "match_engine_batch_execution_on_pre_arrived_events_only",
      "explicit_non_scope": [
        "conversion_to_confirmed_wall_clock_latency",
        "webhook_arrival_latency",
        "processor_settlement_delay",
        "refund_arrival_delay",
        "chargeback_lifecycle_timing"
      ]
    }
  },
  "required_ci_wiring": [
    "python scripts/ci/enforce_b23_pre_p1_spec_gate.py",
    "pytest backend/tests/test_b23_pre_p1_spec_gate_enforcer.py -q"
  ]
}
