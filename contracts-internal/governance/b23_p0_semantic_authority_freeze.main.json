{
  "contract_id": "b23.p0.semantic_authority_freeze.main",
  "contract_version": "1.4.0",
  "repository": "Synergyscape-V1/skeldir-2.0",
  "branch": "main",
  "phase": "B2.3-P0",
  "description": "B2.3-P0 executable semantic authority freeze for deterministic revenue verification and matching handoff boundaries.",
  "baseline_authority": {
    "authoritative_branch": "main",
    "require_main_ancestor_for_semantic_work": true
  },
  "shared_identity_canonicalization": {
    "law_id": "b23_p0_dual_sided_canonicalization_v1",
    "precedence_order": [
      "normalized_commerce_reference",
      "provider_native_commerce_reference",
      "strict_order_id"
    ],
    "canonicalization_failure_state": "canonicalization_failed_explicit",
    "supported_decorated_variants": [
      "#1004",
      "1004",
      "shopify_1004",
      "TX-1004",
      "tx_1004"
    ]
  },
  "privacy_safe_delayed_arrival": {
    "forbidden_mechanisms": [
      "extend_attribution_session_window",
      "cross_session_identity_reconstruction",
      "persist_pii_for_matching",
      "persist_reversible_user_linked_hashes",
      "privacy_ambiguous_shadow_identity_graph"
    ],
    "allowed_topology": "durable_tenant_scoped_non_pii_commerce_identity_substrate",
    "delayed_arrival_policy": "match_via_durable_commerce_identity_else_explicit_unmatched_or_unsupported",
    "topology_schema_binding": {
      "table": "attribution_commerce_identities",
      "required_columns": [
        "tenant_id",
        "attribution_event_id",
        "provider",
        "canonical_commerce_reference",
        "source",
        "first_observed_at",
        "last_observed_at"
      ],
      "forbidden_columns": [
        "session_id",
        "user_id",
        "email",
        "ip_address",
        "gclid",
        "fbclid",
        "external_user_id",
        "device_id"
      ],
      "requires_rls": true
    },
    "lifecycle_binding": {
      "retention_days": 90,
      "db_pruning_mode": "database_scheduled_pruning",
      "pruning_function": "fn_b23_p0_prune_attribution_commerce_identities",
      "pruning_trigger": "trg_b23_p0_prune_attribution_commerce_identities",
      "pruning_schedule": "0 * * * *",
      "pruning_job_name": "b23_p0_prune_attribution_commerce_identities_hourly",
      "prune_batch_size": 1000,
      "activity_independent_enforcement": true
    }
  },
  "financial_truth_semantics": {
    "amount_basis": "verified_captured_amount_minor_units",
    "currency_stance": "same_currency_only_cross_currency_unsupported",
    "unsupported_payment_adjustments": [
      "refund",
      "partial_capture",
      "split_payment",
      "provider_adjustment"
    ]
  },
  "b23_b21_boundary": {
    "b23_scope": "verified_revenue_truth_at_order_conversion_grain",
    "b23_must_not_allocate_attribution": true,
    "downstream_consumers": [
      "B2.1",
      "B2.5"
    ]
  },
  "verdict_taxonomy": [
    "matched",
    "flagged",
    "severe",
    "unmatched",
    "unsupported",
    "canonicalization_failed"
  ],
  "discrepancy_taxonomy": [
    "exact",
    "within_tolerance",
    "over_tolerance",
    "severe_gap",
    "unsupported",
    "identity_failure"
  ],
  "false_authority_exclusions": [
    "/api/attribution/revenue/realtime",
    "/api/reconciliation/platform/{platform_id}",
    "/api/reconciliation/status",
    "/api/v1/revenue/realtime",
    "RevenueReconciliationService",
    "build_attribution_realtime_revenue_response",
    "build_realtime_revenue_v1_response",
    "get_realtime_revenue_snapshot",
    "reconciliation_runs.state",
    "revenue_ledger.discrepancy_bps",
    "revenue_ledger.state"
  ],
  "downstream_mapping": {
    "strategy": "typed_deterministic_mapping_only",
    "verdict_map_target": "b23.verdict.*",
    "discrepancy_map_target": "b23.discrepancy.*",
    "ad_hoc_free_form_translation_forbidden": true,
    "pre_dispatch_validation_required": true
  },
  "performance_authority": {
    "kernel_1000_orders_max_seconds": 5,
    "report_1000_orders_max_seconds": 10
  },
  "required_runtime_proofs": [
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_b06_false_authority_surfaces_are_rejected",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_contract_load_is_authoritative",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_delayed_arrival_topology_binding_is_schema_anchored",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_delayed_arrival_lifecycle_binding_is_bounded_and_database_native",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_downstream_mapping_payload_requires_pre_dispatch_validation",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_dual_sided_canonicalization_converges_decorated_variants",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_false_authority_sources_are_rejected",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_illegal_delayed_arrival_strategies_fail_closed",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_performance_thresholds_are_contract_aligned",
    "backend/tests/test_b23_p0_semantic_authority.py::test_b23_p0_precedence_order_is_deterministic"
  ],
  "required_ci_wiring": [
    "python scripts/ci/enforce_b23_p0_typed_boundary_source_alignment.py",
    "pytest backend/tests/test_b23_p0_typed_boundary_source_alignment_enforcer.py -q",
    "pytest backend/tests/test_b23_p0_semantic_authority.py -q",
    "pytest backend/tests/test_b23_p0_semantic_authority_freeze_enforcer.py -q",
    "python scripts/ci/enforce_b15_p3_runtime_route_binding.py",
    "python scripts/ci/enforce_b15_p4_mock_sdk_boundary.py",
    "python scripts/ci/enforce_b23_p0_semantic_authority_freeze.py"
  ],
  "typed_boundary_adjudication": {
    "required_enforcer": "scripts/ci/enforce_b15_p4_mock_sdk_boundary.py",
    "required_ci_job": "b15-p4-mock-sdk-typed-boundary",
    "required_route_spec_alignment_enforcer": "scripts/ci/enforce_b15_p3_runtime_route_binding.py",
    "required_route_spec_alignment_ci_job": "b15-p3-runtime-route-binding",
    "required_native_source_alignment_enforcer": "scripts/ci/enforce_b23_p0_typed_boundary_source_alignment.py",
    "expected_status": "mainline_clean_no_live_conflict"
  }
}
