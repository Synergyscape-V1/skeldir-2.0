      "canonical_commerce_reference",
      "status",
      "tenant_id",
      "webhook_ingress_identity_id"
    ],
    "webhook_ingress_identities": [
      "event_timestamp",
      "id",
      "provider",
      "tenant_id",
      "verified_amount_currency",
      "verified_amount_minor",
      "verified_commerce_ingress_state"
    ],
    "b26_p2_scope_policy_authority": [
