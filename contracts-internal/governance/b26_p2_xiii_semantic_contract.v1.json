{
  "contract_id": "b26.p2.xiii.semantic_contract",
  "contract_version": "1.0.0",
  "description": "Closed governed P2 semantic language (Corrective XIII Blocker D). Canonical P2 meaning originates from this contract; executable semantics outside it are structurally refused. The contract defines the universe; the parser only proves implementation in allowed universe.",
  "allowed_source_relations": [
    "b23_match_verdicts",
    "webhook_ingress_identities",
    "b26_p2_scope_policy_authority"
  ],
  "allowed_source_columns": {
