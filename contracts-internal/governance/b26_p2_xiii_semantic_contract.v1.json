      "semantic_sha256"
    ]
  },
  "non_semantic_relations": [
    "b26_p2_execution_quarantine",
    "tenants"
  ],
  "row_set_semantics": "one P2 identity per (tenant, canonical window, canonical commerce reference); set membership changes are semantic events",
  "allowed_normalization_operations": [
    "ascii_strip",
    "strip_provider_token",
    "strip_currency_token",
    "normalize_provider",
    "normalize_currency",
    "lower",
    "upper",
    "canonical_day_start",
    "canonical_day_end"
  ],
  "allowed_aggregate_operations": [
    "string_agg"
  ],
  "forbidden_constructs": [
    "dynamic_sql_EXECUTE",
    "dynamic_relation_resolution",
    "custom_operator_mediated_read",
    "unregistered_helper_function",
    "unregistered_view",
    "configuration_driven_relation_identity",
    "undeclared_aggregate_set_read",
    "undeclared_table_existence_count",
    "to_regclass_indirection",
    "fragmented_string_sql",
    "bare_column_unaliased_read",
    "operator_indirection"
  ],
  "allowed_closure_functions": [
    "b26_p2_ascii_strip",
    "b26_p2_canonical_day_end",
    "b26_p2_canonical_day_start",
    "b26_p2_canonical_scope_identity_for_window",
    "b26_p2_classify_candidate",
    "b26_p2_normalize_currency",
    "b26_p2_normalize_provider",
    "b26_p2_strip_currency_token",
    "b26_p2_strip_provider_token"
  ],
  "provider_rail_currency_window_rules": "provider in {paypal,shopify,stripe,woocommerce} via normalize_provider; currency via normalize_currency (USD strict + ^[A-Z]{3}$); window via canonical_day_start/end on event_timestamp (UTC half-open)",
