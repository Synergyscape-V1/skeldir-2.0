FROM python:3.11-slim

# B24_PYMC_CHAINS is deliberately NOT set here.
#
# It was set to 1 from this file's first commit, and it silently outranked
# the governed four-chain inference policy: the image resolved one chain,
# PyMC sampled one chain, R-hat was undefined, and every production fit
# failed its own diagnostics -- while CI, which never builds this image,
# measured four chains and reported the topology as fixed.
#
# The cores and BLAS pins below stay, because those genuinely are
# container-level thread controls that must be set before the process
# starts. Chain count is not a thread control; it is inference policy, and
# it belongs to the policy that owns it. Leaving it unset here means the
# governed default applies.
#
# Anything that does set it -- here, in a compose file, or at docker run --
# is refused before sampling by assert_runtime_matches_profile(), so this
# is a sane default rather than the only line of defence.

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    B24_BAYESIAN_WORKER_RUNTIME_ID=skeldir-b24-bayesian-worker \
    B24_BAYESIAN_WORKER_CONCURRENCY=1 \
    B24_PYMC_CORES=1 \
    B24_BLAS_TOTAL_THREADS=1 \
    B24_PYTENSOR_ROOT=/tmp/skeldir-b24-pytensor \
    PROMETHEUS_MULTIPROC_DIR=/tmp/skeldir-prometheus \
    SKELDIR_CELERY_WORKER_ROLE=bayesian \
    SKELDIR_CELERY_INCLUDE_BAYESIAN_TASKS=1 \
    SKELDIR_BAYESIAN_DB_BACKEND_AFFINITY=connection_lifetime \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    PYTENSOR_FLAGS=mode=FAST_RUN,linker=cvm

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gfortran libopenblas-dev procps \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/skeldir-prometheus \
    && chmod 0770 /tmp/skeldir-prometheus

COPY backend/requirements.txt /app/backend/requirements.txt
COPY backend/requirements-bayesian.txt /app/backend/requirements-bayesian.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt \
    && pip install --no-cache-dir -r /app/backend/requirements-bayesian.txt

COPY backend /app/backend
COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic
COPY contracts-internal/governance /app/contracts-internal/governance
COPY db/channel_mapping.yaml /app/db/channel_mapping.yaml
ENV PYTHONPATH=/app/backend
WORKDIR /app/backend

CMD ["celery", "-A", "app.celery_app", "worker", "-Q", "bayesian", "--loglevel=INFO", "--concurrency=1"]
