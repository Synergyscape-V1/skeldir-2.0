{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeldir.local/trust-api/policy-authority.schema.json",
  "title": "B2.5-P1 PolicyActionAuthority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_state",
    "allowed_scopes",
    "forbidden_scopes",
    "reason_code"
  ],
  "properties": {
    "policy_state": {
      "type": "string",
      "enum": [
        "blocked",
        "read_only",
        "simulation_only",
        "proposal_required",
        "approval_required"
      ]
    },
    "allowed_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "trust.envelope.read",
          "trust.envelope.verify",
          "trust.keys.read",
          "trust.export.create_limited"
        ]
      }
    },
    "forbidden_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "trust.action.execute",
          "trust.policy.override",
          "trust.envelope.mutate"
        ]
      }
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "p1_contract_boundary_only",
        "scope_denied",
        "replay_rejected",
        "verification_only",
        "approval_required",
        "simulation_only"
      ]
    }
  }
}
