{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeldir.local/trust-api/evidence-temporal-boundary.schema.json",
  "title": "B2.5-P1 EvidenceTemporalBoundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_snapshot_at",
    "evidence_snapshot_hash",
    "source_read_started_at",
    "source_read_completed_at",
    "max_source_read_skew_ms",
    "snapshot_consistency_status",
    "data_freshness_seconds",
    "staleness_status"
  ],
  "properties": {
    "evidence_snapshot_at": {
      "anyOf": [
        {"$ref": "https://schemas.skeldir.local/trust-api/trust-envelope.v1.yaml#/$defs/utcTimestamp"},
        {"type": "null"}
      ]
    },
    "source_read_started_at": {
      "anyOf": [
        {"$ref": "https://schemas.skeldir.local/trust-api/trust-envelope.v1.yaml#/$defs/utcTimestamp"},
        {"type": "null"}
      ]
    },
    "source_read_completed_at": {
      "anyOf": [
        {"$ref": "https://schemas.skeldir.local/trust-api/trust-envelope.v1.yaml#/$defs/utcTimestamp"},
        {"type": "null"}
      ]
    },
    "data_freshness_seconds": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 31536000
    },
    "staleness_status": {
      "type": "string",
      "enum": [
        "current",
        "stale_degraded",
        "unavailable"
      ]
    },
    "evidence_snapshot_hash": {
      "$ref": "https://schemas.skeldir.local/trust-api/trust-envelope.v1.yaml#/$defs/sha256Tagged"
    },
    "max_source_read_skew_ms": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 86400000
    },
    "snapshot_consistency_status": {
      "type": "string",
      "enum": [
        "consistent",
        "stale_degraded",
        "unavailable"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "snapshot_consistency_status": {
            "enum": ["consistent", "stale_degraded"]
          }
        },
        "required": ["snapshot_consistency_status"]
      },
      "then": {
        "properties": {
          "evidence_snapshot_at": {
            "$ref": "https://schemas.skeldir.local/trust-api/trust-envelope.v1.yaml#/$defs/utcTimestamp"
          },
          "source_read_started_at": {
            "$ref": "https://schemas.skeldir.local/trust-api/trust-envelope.v1.yaml#/$defs/utcTimestamp"
          },
          "source_read_completed_at": {
            "$ref": "https://schemas.skeldir.local/trust-api/trust-envelope.v1.yaml#/$defs/utcTimestamp"
          },
          "data_freshness_seconds": {"type": "integer"},
          "max_source_read_skew_ms": {"type": "integer"}
        }
      }
    }
  ]
}
