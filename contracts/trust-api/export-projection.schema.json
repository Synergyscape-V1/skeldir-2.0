{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeldir.local/trust-api/export-projection.schema.json",
  "title": "B2.5-P11 Non-Authoritative Display Export Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_authority",
    "projection_schema_version",
    "tenant_id_hash",
    "generated_at",
    "date_range",
    "rows"
  ],
  "properties": {
    "projection_authority": {
      "type": "string",
      "const": "non_authoritative_display"
    },
    "projection_schema_version": {
      "type": "string",
      "const": "b25-p11-display-v1"
    },
    "tenant_id_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "channel",
          "revenue_minor",
          "revenue_display",
          "conversions",
          "confidence_display"
        ],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "channel": {"type": "string"},
          "revenue_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "revenue_display": {"type": "string"},
          "conversions": {"type": "integer", "minimum": 0},
          "confidence_display": {"type": "string"}
        }
      }
    }
  }
}
