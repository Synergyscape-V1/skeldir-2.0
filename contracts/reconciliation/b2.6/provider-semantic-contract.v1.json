{
  "contract_id": "b26-p2-provider-semantic-contract",
  "contract_version": "v1",
  "semantic_regime": "xvii-sovereign-v1",
  "governing_note": "B2.6-P2 Corrective XVII (H-XVII-R7/R8): the governed provider semantic law. The production parser (backend/app/webhooks/commerce_derivation.py) and the independent oracle (scripts/ci/validate_b26_p2_xvi_semantic_oracle.py) are BOTH subordinate to this artifact. A semantic-law change requires an explicit contract revision (new contract_version + new semantic_regime); parser+oracle co-edit without a contract revision is a violation and must RED the contract gate. Parser acceptance set must equal the supported shapes below: implementation convenience may not widen authority.",
  "money_law": {
    "representation": "integer minor units; no DECIMAL/FLOAT persistence",
    "precision_rule": "exact provider precision: a decimal amount whose fractional digits exceed the currency scale is REFUSED, never rounded. Scientific notation is REFUSED (non-plain representation). Trailing zeros within scale are accepted (numeric equality).",
    "scale_rule": "ISO 4217 currency exponents: zero-decimal set and three-decimal set below; every other currency defaults to 2.",
    "zero_decimal_currencies": ["BIF", "CLP", "DJF", "GNF", "ISK", "JPY", "KMF", "KRW", "PYG", "RWF", "UGX", "UYI", "VND", "VUV", "XAF", "XOF", "XPF"],
    "three_decimal_currencies": ["BHD", "IQD", "JOD", "KWD", "LYD", "OMR", "TND"],
    "default_scale": 2,
    "stripe_native": "integer minor units already (amount is integer cents); non-integer or non-positive amounts REFUSED"
  },
  "identity_law": {
    "event_identity": "one immutable provider event identity denotes one canonical lineage. Same (tenant, provider, provider_native_event_reference) with different authenticated bytes MUST NOT create a second canonical lineage: explicit conflict refusal.",
    "commerce_conservation": "one economic commerce identity denotes one canonical financial fact within the supported lifecycle. Same (tenant, provider, normalized_commerce_reference_kind, normalized_commerce_reference_value) across distinct provider events MUST NOT create a second canonical lineage: explicit conflict refusal. First-authenticated wins; conflicts are refused, never silently double-counted.",
    "redelivery": "byte-identical redelivery of the same provider event is idempotent (same lineage); it never mints a second lineage"
  },
  "providers": {
    "stripe": {
      "supported_event_families": ["payment_intent.succeeded", "payment_intent_succeeded"],
      "accepted_shapes": ["flat payment_intent object {id, amount, currency, created}", "envelope event {id, created, data.object{id, amount, currency, created}}"],
      "event_identity_field": "envelope event id when in envelope shape, else payment_intent id",
      "commerce_reference_field": "payment_intent id (data.object.id in envelope shape)",
      "amount_field": "integer cents (data.object.amount in envelope shape)",
      "currency_field": "3-letter code (data.object.currency in envelope shape)",
      "timestamp_field": "top-level envelope instant payload.created preferred (reconciliation-day law); object instant obj.created as fallback; flat shape uses payload.created",
      "timestamp_rationale": "the envelope instant is when the provider emitted the financial event; window placement follows the provider emission, not the inner object creation",
      "refused_shapes": ["checkout.session objects (amount_total is not a payment_intent amount)", "envelope with top-level amount/currency keys (ambiguous dual-meaning payload)", "data key present without a usable data.object.id (ambiguous wrapper: neither flat nor envelope)"]
    },
    "shopify": {
      "supported_event_families": ["orders.create", "order_create"],
      "accepted_shapes": ["order JSON {id, total_price, currency, created_at}"],
      "event_identity_field": "order id",
      "commerce_reference_field": "order id",
      "amount_field": "total_price decimal string in major units, exact currency precision",
      "currency_field": "currency 3-letter code",
      "timestamp_field": "created_at (order creation instant)",
      "refused_shapes": ["missing created_at (no wall-clock substitution)", "scientific-notation amounts", "excess-precision amounts"]
    },
    "paypal": {
      "supported_event_families": ["payment.sale.completed", "sale_completed"],
      "accepted_shapes": ["flat sale JSON {id, amount{total, currency}, create_time}"],
      "event_identity_field": "transaction id",
      "commerce_reference_field": "transaction id",
      "amount_field": "amount.total decimal string in major units, exact currency precision",
      "currency_field": "amount.currency 3-letter code",
      "timestamp_field": "create_time (sale completion instant)",
      "refused_shapes": ["resource-enveloped webhooks (top-level resource object is not a transaction; must be refused, not coerced)", "missing create_time", "scientific-notation or excess-precision amounts"]
    },
    "woocommerce": {
      "supported_event_families": ["order.completed", "order_completed"],
      "accepted_shapes": ["order JSON {id, total, currency, date_completed and/or date_created}"],
      "event_identity_field": "order id",
      "commerce_reference_field": "order id",
      "amount_field": "total decimal string in major units, exact currency precision",
      "currency_field": "currency 3-letter code",
      "timestamp_field": "date_completed preferred (completion-time law: revenue is recognized at completion); date_created as governed fallback when completion is absent",
      "timestamp_rationale": "completion time places the financial fact in the reconciliation window where the order became revenue; the creation fallback is governed (not convenience): a completion-less order payload still denotes the order's financial fact and must not be silently dropped",
      "refused_shapes": ["missing both date_completed and date_created", "scientific-notation or excess-precision amounts"]
    }
  },
